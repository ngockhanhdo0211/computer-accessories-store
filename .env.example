APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_CONNECT_TIMEOUT=2
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# MYSQL_ATTR_SSL_CA=/etc/secrets/aiven-ca.pem
# MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production behind Render TLS: true
# SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRODUCT_IMAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=computer-accessories-store/production
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TERMINAL_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://example.test/checkout/vnpay/return
VNPAY_VERSION=2.1.0
VNPAY_TIMEZONE=Asia/Ho_Chi_Minh
VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_REFUND_CREATE_BY=
VNPAY_REFUND_IP_ADDRESS=
VNPAY_REFUND_CONNECT_TIMEOUT=5
VNPAY_REFUND_TIMEOUT=15
VNPAY_REFUND_SUBMISSION_STALE_SECONDS=120

VITE_APP_NAME="${APP_NAME}"

# Render production startup only; keep false until the external database gate passes.
RUN_MIGRATIONS=false
